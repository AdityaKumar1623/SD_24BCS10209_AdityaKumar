        <mxCell id="8" parent="1" style="shape=rectangle;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Analytics Worker" vertex="1">
          <mxGeometry height="60" width="160" x="610" y="2460" as="geometry" />
