        <mxCell id="fGXQRnpm17kImUP3dvJX-56" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h2 style=&quot;forced-color-adjust: none; color: rgb(0, 0, 0); font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Database Schema&lt;/h2&gt;" vertex="1">
          <mxGeometry height="70" width="190" x="40" y="1180" as="geometry" />
        </mxCell>
        <mxCell id="fGXQRnpm17kImUP3dvJX-57" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=14;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Column Name&lt;/th&gt;&lt;th&gt;Data Type&lt;/th&gt;&lt;th&gt;Constraints / Notes&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th scope=&quot;row&quot;&gt;&lt;strong&gt;id&lt;/strong&gt;&lt;/th&gt;&lt;td&gt;BIGINT&lt;/td&gt;&lt;td&gt;Primary Key, Auto Increment&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;th scope=&quot;row&quot;&gt;&lt;strong&gt;short_key&lt;/strong&gt;&lt;/th&gt;&lt;td&gt;VARCHAR(10)&lt;/td&gt;&lt;td&gt;Unique, Not Null (Base62 encoded key or custom)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;th scope=&quot;row&quot;&gt;&lt;strong&gt;long_url&lt;/strong&gt;&lt;/th&gt;&lt;td&gt;TEXT&lt;/td&gt;&lt;td&gt;Not Null (stores original long URL)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;th scope=&quot;row&quot;&gt;&lt;strong&gt;created_at&lt;/strong&gt;&lt;/th&gt;&lt;td&gt;TIMESTAMP&lt;/td&gt;&lt;td&gt;Default = CURRENT_TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;th scope=&quot;row&quot;&gt;&lt;strong&gt;expires_at&lt;/strong&gt;&lt;/th&gt;&lt;td&gt;TIMESTAMP&lt;/td&gt;&lt;td&gt;Nullable (expiry date for short URL)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;th scope=&quot;row&quot;&gt;&lt;strong&gt;user_id&lt;/strong&gt;&lt;/th&gt;&lt;td&gt;BIGINT&lt;/td&gt;&lt;td&gt;Nullable, Foreign Key (if user accounts exist)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;th scope=&quot;row&quot;&gt;&lt;strong&gt;click_count&lt;/strong&gt;&lt;/th&gt;&lt;td&gt;BIGINT&lt;/td&gt;&lt;td&gt;Default = 0 (tracks number of redirects)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;th scope=&quot;row&quot;&gt;&lt;strong&gt;last_accessed&lt;/strong&gt;&lt;/th&gt;&lt;td&gt;TIMESTAMP&lt;/td&gt;&lt;td&gt;Nullable (last time the short URL was used)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;th scope=&quot;row&quot;&gt;&lt;strong&gt;is_active&lt;/strong&gt;&lt;/th&gt;&lt;td&gt;BOOLEAN&lt;/td&gt;&lt;td&gt;Default = TRUE (soft delete / disable option)&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="210" width="580" x="40" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="fGXQRnpm17kImUP3dvJX-58" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;h2&gt;API Methods &amp;amp; Endpoints&lt;/h2&gt;&lt;h3&gt;1. Create Short URL&lt;/h3&gt;&lt;ul role=&quot;list&quot;&gt;&lt;li&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong&gt;POST /api/shorten&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;Request:&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div class=&quot;rounded-b-xl bg-background-static-850 px-4 pb-1.5 dark:bg-background-static-900&quot;&gt;&lt;div style=&quot;white-space: pre;&quot;&gt;&lt;pre&gt;&lt;code&gt;{&lt;br&gt;  &quot;long_url&quot;: &quot;https://example.com/product?id=123&quot;,&lt;br&gt;  &quot;custom_key&quot;: &quot;myalias&quot;,&lt;br&gt;  &quot;expires_at&quot;: &quot;2026-12-31&quot;&lt;br&gt;}&lt;br&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;ul role=&quot;list&quot;&gt;&lt;li&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;Response:&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;{&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;rounded-b-xl bg-background-static-850 px-4 pb-1.5 dark:bg-background-static-900&quot;&gt;&lt;div style=&quot;white-space: pre;&quot;&gt;&lt;pre&gt;&lt;code&gt;  &quot;short_url&quot;: &quot;https://tinyurl.com/myalias&quot;&lt;br&gt;}&lt;br&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;h3&gt;2. Redirect&lt;/h3&gt;&lt;ul role=&quot;list&quot;&gt;&lt;li&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong&gt;GET /{short_key}&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;Server looks up &lt;code&gt;short_key&lt;/code&gt; → returns HTTP 302 redirect to &lt;code&gt;long_url&lt;/code&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;3. Analytics&lt;/h3&gt;&lt;ul role=&quot;list&quot;&gt;&lt;li&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong&gt;GET /api/stats/{short_key}&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;Response:&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;{&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;rounded-b-xl bg-background-static-850 px-4 pb-1.5 dark:bg-background-static-900&quot;&gt;&lt;div style=&quot;white-space: pre;&quot;&gt;&lt;pre&gt;&lt;code&gt;  &quot;short_key&quot;: &quot;abc123&quot;,&lt;br&gt;  &quot;long_url&quot;: &quot;https://example.com/product?id=123&quot;,&lt;br&gt;  &quot;click_count&quot;: 542,&lt;br&gt;  &quot;created_at&quot;: &quot;2026-07-31&quot;&lt;br&gt;}&lt;br&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;h3&gt;4. Delete URL (optional)&lt;/h3&gt;&lt;ul role=&quot;list&quot;&gt;&lt;li&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong&gt;DELETE /api/{short_key}&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="730" width="780" x="40" y="1460" as="geometry" />
        </mxCell>
        <mxCell id="fGXQRnpm17kImUP3dvJX-59" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=18;" value="System Architecture" vertex="1">
          <mxGeometry height="30" width="190" x="20" y="2210" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
